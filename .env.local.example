# Clerk Authentication (GitHub Only Login)
# Get these keys from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_your_clerk_publishable_key_here
CLERK_SECRET_KEY=clerk_secret_key_placeholder_here

# Neon PostgreSQL Database Connection String
# Get this from https://console.neon.tech -> Connection Details
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
